# Required: replace this placeholder with your own provider key.
LLM_API_KEY=replace_with_your_llm_api_key

# Optional overrides. Leave these commented to use the validated defaults in
# server/config.ts; uncomment only after replacing the placeholder value.
# LLM_MODEL=replace_with_your_vision_model_name
# LLM_BASE_URL=https://replace_with_your_provider_base_url/v1
# ACCOUNTING_API_BASE_URL=http://replace_with_accounting_api_host:8080
# ACCOUNTING_API_KEY=replace_with_accounting_api_key
# SERVER_PORT=replace_with_server_port
# MAX_UPLOAD_MB=replace_with_upload_limit_in_megabytes

# Optional: used only by npm run verify:samples.
# APP_BASE_URL=http://replace_with_application_server_host:3001
